import * as XLSX from "xlsx"

/**
 * Utilitários para exportação de dados
 * Suporta CSV e Excel (XLSX)
 */

/**
 * Converte array de objetos para CSV
 */
export function convertToCSV(data: any[], columns?: string[]): string {
  if (data.length === 0) return ""

  // Define colunas (usa as chaves do primeiro objeto se não fornecidas)
  const headers = columns || Object.keys(data[0])
  
  // Linha de cabeçalho
  const csvHeaders = headers.join(",")
  
  // Linhas de dados
  const csvRows = data.map(row => {
    return headers.map(header => {
      const value = row[header]
      
      // Trata valores nulos/undefined
      if (value === null || value === undefined) return ""
      
      // Trata strings com vírgulas ou quebras de linha
      const stringValue = String(value)
      if (stringValue.includes(",") || stringValue.includes("\n") || stringValue.includes('"')) {
        return `"${stringValue.replace(/"/g, '""')}"`
      }
      
      return stringValue
    }).join(",")
  })
  
  return [csvHeaders, ...csvRows].join("\n")
}

/**
 * Exporta dados para arquivo CSV
 */
export function exportToCSV(data: any[], filename: string, columns?: string[]): void {
  const csv = convertToCSV(data, columns)
  const blob = new Blob(["\ufeff" + csv], { type: "text/csv;charset=utf-8;" }) // BOM para UTF-8
  const link = document.createElement("a")
  
  const url = URL.createObjectURL(blob)
  link.setAttribute("href", url)
  link.setAttribute("download", `${filename}.csv`)
  link.style.visibility = "hidden"
  
  document.body.appendChild(link)
  link.click()
  document.body.removeChild(link)
  
  URL.revokeObjectURL(url)
}

/**
 * Exporta dados para Excel (XLSX)
 * Requer a biblioteca 'xlsx' instalada
 * 
 * @example
 * ```ts
 * // Instalar: npm install xlsx
 * import * as XLSX from 'xlsx'
 * 
 * exportToExcel(data, 'empresas', XLSX, columns)
 * ```
 */
export function exportToExcel(
  data: any[],
  filename: string,
  XLSX: any,
  columns?: string[]
): void {
  if (!XLSX) {
    console.error("Biblioteca XLSX não encontrada. Instale com: npm install xlsx")
    return
  }

  // Prepara os dados para o Excel
  let worksheetData = data

  // Se colunas específicas foram fornecidas, filtra os dados
  if (columns) {
    worksheetData = data.map(row => {
      const filteredRow: any = {}
      columns.forEach(col => {
        filteredRow[col] = row[col]
      })
      return filteredRow
    })
  }

  // Cria worksheet e workbook
  const worksheet = XLSX.utils.json_to_sheet(worksheetData)
  const workbook = XLSX.utils.book_new()
  XLSX.utils.book_append_sheet(workbook, worksheet, "Dados")

  // Auto-ajusta largura das colunas
  const maxWidths: { [key: string]: number } = {}
  const headers = columns || Object.keys(data[0] || {})

  headers.forEach(header => {
    maxWidths[header] = header.length
  })

  worksheetData.forEach(row => {
    headers.forEach(header => {
      const value = String(row[header] || "")
      maxWidths[header] = Math.max(maxWidths[header], value.length)
    })
  })

  worksheet["!cols"] = headers.map(header => ({
    wch: Math.min(maxWidths[header] + 2, 50) // Máx 50 caracteres
  }))

  // Gera e baixa o arquivo
  XLSX.writeFile(workbook, `${filename}.xlsx`)
}

/**
 * Formata dados para exportação (remove campos técnicos, formata valores)
 */
export function formatDataForExport(
  data: any[],
  fieldLabels?: Record<string, string>
): any[] {
  return data.map(row => {
    const formattedRow: any = {}

    Object.entries(row).forEach(([key, value]) => {
      // Pula campos técnicos
      if (key.startsWith("_") || key === "id") return

      // Usa label customizado ou nome do campo
      const label = fieldLabels?.[key] || key

      // Formata valores
      if (value === null || value === undefined) {
        formattedRow[label] = "-"
      } else if (typeof value === "boolean") {
        formattedRow[label] = value ? "Sim" : "Não"
      } else if (value instanceof Date) {
        formattedRow[label] = value.toLocaleDateString("pt-BR")
      } else if (typeof value === "number" && key.includes("valor")) {
        // Formata valores monetários
        formattedRow[label] = new Intl.NumberFormat("pt-BR", {
          style: "currency",
          currency: "BRL",
        }).format(value)
      } else {
        formattedRow[label] = value
      }
    })

    return formattedRow
  })
}

