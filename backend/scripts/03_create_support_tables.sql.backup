$$ LANGUAGE plpgsql;

-- Trigger
DROP TRIGGER IF EXISTS trigger_uso_credito ON pesquisa_cnpj;
CREATE TRIGGER trigger_uso_credito
    AFTER INSERT ON pesquisa_cnpj
    FOR EACH ROW
    EXECUTE FUNCTION registrar_uso_credito();

\echo 'Função e trigger de débito automático criados ✓';

-- ========================================
-- 8. FUNÇÃO: validar_creditos_suficientes
-- ========================================

CREATE OR REPLACE FUNCTION validar_creditos_suficientes()
RETURNS TRIGGER AS $$
DECLARE
    saldo_atual INTEGER;
BEGIN
    -- Buscar saldo atual
    SELECT saldo_creditos INTO saldo_atual
    FROM usuarios
    WHERE id = NEW.user_id;
    
    -- Validar se tem créditos suficientes
    IF saldo_atual < NEW.creditos_usados THEN
        RAISE EXCEPTION 'Créditos insuficientes. Saldo: %, Necessário: %', 
            saldo_atual, NEW.creditos_usados;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger
DROP TRIGGER IF EXISTS trigger_validar_creditos ON pesquisa_cnpj;
CREATE TRIGGER trigger_validar_creditos
    BEFORE INSERT ON pesquisa_cnpj
    FOR EACH ROW
    EXECUTE FUNCTION validar_creditos_suficientes();

\echo 'Função e trigger de validação de créditos criados ✓';

