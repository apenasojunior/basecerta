-- ================================================================
-- ✅ TABELAS JÁ EXISTENTES (REAPROVEITAR)
-- ================================================================
-- public.users                 - Sistema de usuários
-- public.user_credits          - Saldo de créditos por usuário
-- public.credit_transactions   - Histórico de transações
-- public.plans                 - Planos de assinatura
-- public.credit_packages       - Pacotes de créditos
-- public.alembic_version       - Controle de migrações
-- ================================================================

\echo 'Verificando tabelas existentes de usuários e créditos...';
\echo '';

-- Verificar se user_id=1 existe (usuário de teste)
DO $$
BEGIN
    IF NOT EXISTS (SELECT 1 FROM public.users WHERE id = 1) THEN
        -- Criar usuário de teste
        INSERT INTO public.users (id, email, full_name, is_active, is_superuser, created_at, updated_at)
        VALUES (1, 'teste@basecerta.com', 'Usuário Teste', true, false, NOW(), NOW());
        
        -- Criar registro de créditos para o usuário
        INSERT INTO public.user_credits (user_id, balance, total_earned, total_spent, created_at, updated_at)
        VALUES (1, 10000, 10000, 0, NOW(), NOW());
        
        RAISE NOTICE '✅ Usuário teste (id=1) criado com 10.000 créditos';
    ELSE
        RAISE NOTICE '✅ Usuário teste (id=1) já existe';
    END IF;
END $$;

\echo '';

-- ================================================================
-- 🆕 TABELA NOVA: pesquisa_cnpj
-- ================================================================
-- Histórico de buscas realizadas no Smart CNPJ
-- Relaciona com public.users (FK)

\echo 'Criando tabela pesquisa_cnpj...';

CREATE TABLE IF NOT EXISTS public.pesquisa_cnpj (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id INTEGER NOT NULL REFERENCES public.users(id) ON DELETE CASCADE,
    
    -- Busca realizada
    tipo_busca VARCHAR(20) NOT NULL CHECK (
        tipo_busca IN ('cnpj', 'razao_social', 'segmento', 'email', 'telefone', 'nome_socio', 'cep')
    ),
    valor_busca TEXT NOT NULL,
    
    -- Filtros aplicados (JSON)
    filtros_aplicados JSONB,
    
    -- Resultados
    total_resultados INTEGER,
    
    -- Créditos
    creditos_usados INTEGER DEFAULT 5 NOT NULL,
    
    -- Performance (para monitoramento)
    tempo_resposta_ms INTEGER,
    
    -- Auditoria
    created_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP WITHOUT TIME ZONE DEFAULT CURRENT_TIMESTAMP,
    
    -- Cache: CNPJ se busca foi por CNPJ específico
    cnpj_encontrado VARCHAR(18)
);

-- Índices para performance
CREATE INDEX IF NOT EXISTS idx_pesquisa_user_id ON public.pesquisa_cnpj(user_id);
CREATE INDEX IF NOT EXISTS idx_pesquisa_cnpj ON public.pesquisa_cnpj(cnpj_encontrado);
CREATE INDEX IF NOT EXISTS idx_pesquisa_created_at ON public.pesquisa_cnpj(created_at DESC);
CREATE INDEX IF NOT EXISTS idx_pesquisa_tipo_busca ON public.pesquisa_cnpj(tipo_busca);
CREATE INDEX IF NOT EXISTS idx_pesquisa_user_created ON public.pesquisa_cnpj(user_id, created_at DESC);

-- Índice GIN para busca no JSONB de filtros
CREATE INDEX IF NOT EXISTS idx_pesquisa_filtros_gin ON public.pesquisa_cnpj USING gin (filtros_aplicados);

\echo '✅ Tabela pesquisa_cnpj criada';
\echo '';

-- ================================================================
-- ⚙️ TRIGGER: Registrar Uso de Crédito Automaticamente
-- ================================================================
-- Quando uma pesquisa é inserida em pesquisa_cnpj, debitar créditos

\echo 'Criando trigger para débito automático de créditos...';

CREATE OR REPLACE FUNCTION registrar_uso_credito()
RETURNS TRIGGER AS $$
BEGIN
    -- Atualizar saldo de créditos do usuário
    UPDATE public.user_credits
    SET 
        balance = balance - NEW.creditos_usados,
        total_spent = total_spent + NEW.creditos_usados,
        updated_at = NOW()
    WHERE user_id = NEW.user_id;
    
    -- Registrar transação
    INSERT INTO public.credit_transactions (
        user_id,
        type,
        amount,
        balance_after,
        description,
        created_at,
        updated_at
    )
    SELECT 
        NEW.user_id,
        'debit',  -- Assumindo que o ENUM tem 'debit'
        NEW.creditos_usados,
        uc.balance,
        CONCAT('Busca Smart CNPJ: ', NEW.tipo_busca, ' - ', LEFT(NEW.valor_busca, 50)),
        NOW(),
        NOW()
    FROM public.user_credits uc
    WHERE uc.user_id = NEW.user_id;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Associar trigger à tabela pesquisa_cnpj
DROP TRIGGER IF EXISTS trg_registrar_uso_credito ON public.pesquisa_cnpj;
CREATE TRIGGER trg_registrar_uso_credito
    AFTER INSERT ON public.pesquisa_cnpj
    FOR EACH ROW
    EXECUTE FUNCTION registrar_uso_credito();

\echo '✅ Trigger de débito automático criado';
\echo '';

